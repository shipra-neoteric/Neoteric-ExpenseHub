NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/expensehub
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
APP_TIMEZONE=Asia/Kolkata
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
LOW_BALANCE_THRESHOLD_PAISE=200000

# Public HTTPS URL of this API (no trailing slash), e.g.
# https://neoteric-expensehub.onrender.com — used to build the receipt link
# Slack fetches for the approval DM. Required for Slack to work; harmless to
# leave unset otherwise.
APP_BASE_URL=

# Shared secret the external monthly-rollover scheduler sends as the
# X-Automation-Secret header. Generate a long random string; see DEPLOYMENT.md.
AUTOMATION_SECRET=

# Slack App credentials — see SLACK_SETUP.md. Leave both unset to disable
# Slack notifications entirely (submissions/approvals work normally either way).
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
